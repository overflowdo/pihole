# ── Pi-hole – Umgebung ───────────────────────────────────────────────────────
# Wird von nixos/install.sh automatisch mit einem Zufallspasswort nach
# /opt/pihole/.env geschrieben. Nach Änderungen:
#     cd /opt/pihole && docker compose up -d
#
# NIEMALS committen – .env ist in .gitignore.

# Zeitzone
TZ=Europe/Berlin

# Admin-/API-Passwort des Pi-hole-Webinterfaces (Pi-hole v6).
FTLCONF_webserver_api_password=CHANGEME

# Upstream-DNS (Semikolon-getrennt). Standard: FritzBox, damit fritz.box &
# andere lokale Gerätenamen weiter auflösen. Alternativ z.B. 1.1.1.1;9.9.9.9
FTLCONF_dns_upstreams=192.168.178.1
